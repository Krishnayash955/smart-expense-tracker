# Reference list of every environment variable the project uses.
# Real values go in backend/.env and frontend/.env (both git-ignored).
# Never put real secrets in this file.

# --- Backend (backend/.env) ---
APP_ENV=development
# Neon connection string. Use the "psycopg" driver prefix, e.g.
# postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env) ---
# Only non-secret values here: anything prefixed VITE_ is visible in the browser.
VITE_API_URL=http://localhost:8000/api/v1
